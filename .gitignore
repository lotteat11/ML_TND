# Virtual environments
ven_2404/
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data files (large, not version-controlled)
*.parquet
*.nc
*.hdf5
*.h5

# Model outputs
*.joblib
*.json
*.pkl
*.csv

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Workshop — track the notebooks, model/scaler, and small parquet via Git LFS
# (these override the broad *.ipynb / *.json / *.joblib / *.parquet rules above).
# The full grace_workshop.parquet stays ignored (local dev only).
!workshop/*.ipynb
!workshop/nb3_model_cyclic.json
!workshop/nb3_scaler_cyclic.joblib
!grace_workshop_small.parquet
